{
  "openapi": "3.0.3",
  "info": {
    "title": "utoken 云大师 Agent API（基于 new-api）",
    "version": "2026-11-18",
    "description": "设备授权、来源管理及现有管理 API 契约。可导入 Apifox；完整权限、额度及分页语义见 agent-api.md。浏览器批准需要真实会话和页面 CSRF，不支持由设备凭证自行批准。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "替换为测试实例 origin；生产必须 HTTPS"
    }
  ],
  "paths": {
    "/oauth/device/code": {
      "post": {
        "summary": "申请设备授权码",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "client_id"
                ],
                "properties": {
                  "client_id": {
                    "type": "string",
                    "enum": [
                      "yundashi-agent"
                    ]
                  },
                  "scope": {
                    "type": "string",
                    "example": "token:manage user:read log:read"
                  },
                  "device_name": {
                    "type": "string",
                    "maxLength": 100
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "设备挑战；等待至少 interval 秒后轮询",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAuthorization"
                }
              }
            }
          },
          "400": {
            "description": "OAuth 请求错误或轮询状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "429": {
            "description": "限流；响应可能为空"
          },
          "500": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/device/token": {
      "post": {
        "summary": "轮询并一次性兑换设备凭证",
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "required": [
                  "grant_type",
                  "client_id",
                  "device_code"
                ],
                "properties": {
                  "grant_type": {
                    "type": "string",
                    "enum": [
                      "urn:ietf:params:oauth:grant-type:device_code"
                    ]
                  },
                  "client_id": {
                    "type": "string",
                    "enum": [
                      "yundashi-agent"
                    ]
                  },
                  "device_code": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "30 天独立凭证，不返回 refresh_token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceAccess"
                }
              }
            }
          },
          "400": {
            "description": "OAuth 请求错误或轮询状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          },
          "429": {
            "description": "限流；响应可能为空"
          },
          "500": {
            "description": "服务端错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthError"
                }
              }
            }
          }
        }
      }
    },
    "/oauth/device": {
      "get": {
        "summary": "浏览器设备授权页",
        "description": "现有浏览器会话登录；未登录则显示登录入口。",
        "responses": {
          "200": {
            "description": "HTML 页面",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "提交浏览器决定",
        "description": "从 GET 页面获取 CSRF 字段，只接受浏览器会话。",
        "responses": {
          "200": {
            "description": "批准/拒绝后的 HTML 页面"
          },
          "303": {
            "description": "撤销后跳转管理页"
          },
          "400": {
            "description": "无效授权"
          },
          "403": {
            "description": "会话或 CSRF 无效"
          }
        }
      }
    },
    "/oauth/device/grants": {
      "get": {
        "summary": "浏览器设备授权管理页",
        "description": "现有浏览器会话登录；未登录则显示登录入口。",
        "responses": {
          "200": {
            "description": "HTML 页面",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "撤销设备及关联 key",
        "description": "从 GET 页面获取 CSRF 字段，只接受浏览器会话。",
        "responses": {
          "200": {
            "description": "批准/拒绝后的 HTML 页面"
          },
          "303": {
            "description": "撤销后跳转管理页"
          },
          "400": {
            "description": "无效授权"
          },
          "403": {
            "description": "会话或 CSRF 无效"
          }
        }
      }
    },
    "/api/user/self": {
      "get": {
        "summary": "读取个人资料及余额",
        "responses": {
          "200": {
            "description": "检查 success，原有业务错误可能使用 HTTP 200",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "401": {
            "description": "凭证失效或用户 ID 不匹配"
          },
          "403": {
            "description": "权限不足"
          },
          "429": {
            "description": "限流，可能无 JSON"
          }
        },
        "security": [
          {
            "DeviceBearer": []
          },
          {
            "SystemBearer": []
          }
        ],
        "parameters": [
          {
            "name": "New-Api-User",
            "in": "header",
            "required": false,
            "description": "系统访问令牌必须携带用户数字 ID；设备令牌可省略，提供时须匹配账号。",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "description": "设备凭证需要 user:read。详见 agent-api.md。"
      }
    },
    "/api/user/token": {
      "get": {
        "summary": "生成/重置原有系统访问令牌",
        "responses": {
          "200": {
            "description": "检查 success，原有业务错误可能使用 HTTP 200",
            "content": {
