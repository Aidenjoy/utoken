  "components": {
    "securitySchemes": {
      "DeviceBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "/oauth/device/token 返回的 udv_ 设备访问令牌"
      },
      "SystemBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "现有系统令牌；额外必须提供 New-Api-User"
      }
    },
    "schemas": {
      "OAuthError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Envelope": {
        "type": "object",
        "required": [
          "success"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "error": {
            "type": "string"
          }
        }
      },
      "DeviceAuthorization": {
        "type": "object",
        "required": [
          "device_code",
          "user_code",
          "verification_uri",
          "verification_uri_complete",
          "expires_in",
          "interval"
        ],
        "properties": {
          "device_code": {
            "type": "string"
          },
          "user_code": {
            "type": "string"
          },
          "verification_uri": {
            "type": "string"
          },
          "verification_uri_complete": {
            "type": "string"
          },
          "expires_in": {
            "type": "integer",
            "example": 600
          },
          "interval": {
            "type": "integer",
            "example": 5
          }
        }
      },
      "DeviceAccess": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in",
          "scope",
          "user_id",
          "username"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "example": "Bearer"
          },
          "expires_in": {
            "type": "integer",
            "example": 2592000
          },
          "scope": {
            "type": "string"
          },
          "user_id": {
            "type": "integer"
          },
          "username": {
            "type": "string"
          }
        }
      },
      "CreateToken": {
        "type": "object",
        "required": [
          "name",
          "expired_time",
          "unlimited_quota"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 50
          },
          "expired_time": {
            "type": "integer",
            "format": "int64",
            "example": -1
          },
          "unlimited_quota": {
            "type": "boolean",
            "example": true
          },
          "remain_quota": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "maxLength": 64,
            "example": "yundashi-agent"
          },
          "group": {
            "type": "string",
            "description": "可选，沿用服务端分组权限；不应假定存在 agent 组"
          }
        }
      }
    }
  }
}
