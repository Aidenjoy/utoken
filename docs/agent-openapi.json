          "401": {
            "description": "凭证失效或用户 ID 不匹配"
          },
          "403": {
            "description": "权限不足"
          },
          "429": {
            "description": "限流，可能无 JSON"
          }
        },
        "security": [
          {
            "SystemBearer": []
          }
        ],
        "parameters": [
          {
            "name": "New-Api-User",
            "in": "header",
            "required": true,
            "description": "系统访问令牌必须携带用户数字 ID；设备令牌可省略，提供时须匹配账号。",
            "schema": {
              "type": "integer"
            }
          }
        ],
        "description": "设备令牌禁止；此 GET 会覆盖原系统令牌，不是匿名登录或读取操作。data 为新令牌字符串。"
      }
    },
